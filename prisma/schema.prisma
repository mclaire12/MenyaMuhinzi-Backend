/// USSD and IVR channel switches and limits. No telecom provider is integrated by default.
model TelephonyChannelSetting {
  channel            String   @id @db.VarChar(8)
  isEnabled          Boolean  @default(false)
  serviceCode        String?  @db.VarChar(32)
  accessNumber       String?  @db.VarChar(32)
  sessionTtlSeconds  Int
  maxScreenChars     Int      @default(160)
  menuVersion        String   @default("1") @db.VarChar(16)
  updatedById        String?  @db.Uuid
  updatedAt          DateTime @updatedAt

  updatedBy User? @relation("TelephonyChannelSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("telephony_channel_settings")
}
