# ------------------------------------------------------------------
# MenyaMuhinzi Backend - environment configuration
# Copy this file to `.env` and adjust values. Never commit `.env`.
# ------------------------------------------------------------------

# Application
NODE_ENV=development
APP_NAME=MenyaMuhinzi API
APP_PORT=4000
API_PREFIX=api
API_VERSION=1
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs in development (requires pino-pretty dev dependency)
LOG_PRETTY=true

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# PostgreSQL (used by docker-compose and the application)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=menyamuhinzi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=menyamuhinzi
DATABASE_URL=postgresql://menyamuhinzi:change-me@localhost:5432/menyamuhinzi?schema=public

# Redis (cache + BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# BullMQ
QUEUE_PREFIX=menyamuhinzi

# JWT / sessions. Secrets must be at least 32 characters; generate them with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-32-chars-or-more
JWT_ACCESS_EXPIRES_IN=15m
# Also used as the HMAC key for hashing refresh and password-reset tokens
JWT_REFRESH_SECRET=replace-with-another-long-random-string-of-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=menyamuhinzi-api
JWT_AUDIENCE=menyamuhinzi-clients

# Authentication policy
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_RESET_TTL_MINUTES=30
# When true, self-registered smartphone farmers wait for administrator approval
AUTH_FARMER_REQUIRES_APPROVAL=true
# Development only: include the password-reset token in the API response (ignored in production)
AUTH_EXPOSE_RESET_TOKEN=false

# Rate limiting (requests per window, per client IP)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Stricter limit for login, registration and password-reset endpoints
AUTH_RATE_LIMIT_MAX=10

# Knowledge base. Uploaded files are written here, never into PostgreSQL.
KNOWLEDGE_STORAGE_DIR=./storage/knowledge
# Maximum upload size in bytes (20 MB)
KNOWLEDGE_MAX_FILE_BYTES=20971520
# Chunk size and overlap in characters; overlap must be at most half the chunk size
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
# Limits for the isolated PDF/DOCX text extraction worker
KNOWLEDGE_MAX_PAGES=500
KNOWLEDGE_EXTRACTION_TIMEOUT_MS=60000
KNOWLEDGE_EXTRACTION_MEMORY_MB=256
# BullMQ attempts per pipeline stage, and whether this process runs the knowledge worker
KNOWLEDGE_JOB_ATTEMPTS=3
KNOWLEDGE_WORKER_ENABLED=true
KNOWLEDGE_WORKER_CONCURRENCY=2

# AI orchestration foundation. No AI provider is integrated and no provider API keys are read;
# without a registered provider every AI request fails with AI_PROVIDER_NOT_CONFIGURED.
AI_WORKER_ENABLED=true
AI_WORKER_CONCURRENCY=2
# BullMQ attempts for transient failures (configuration errors are never retried)
AI_REQUEST_ATTEMPTS=3
# Maximum characters of approved knowledge placed into an assembled prompt
AI_CONTEXT_MAX_CHARS=8000

# Notification delivery foundation. No SMS, email, push, USSD or IVR provider is integrated and no
# provider keys are read; only the in-app inbox is delivered by the platform itself.
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_WORKER_CONCURRENCY=4
# BullMQ attempts for transient provider errors (configuration errors are never retried)
NOTIFICATIONS_DELIVERY_ATTEMPTS=3

# Initial administrator created by `npm run db:seed` (skipped when the password is empty)
SEED_ADMIN_FULL_NAME=MenyaMuhinzi Administrator
SEED_ADMIN_PHONE=+250788000000
SEED_ADMIN_EMAIL=admin@menyamuhinzi.rw
SEED_ADMIN_PASSWORD=

# Integration tests (npm run test:integration). Defaults to DATABASE_URL with `_test` appended
# to the database name; the database name must end in `_test` because tests truncate it.
# TEST_DATABASE_URL=postgresql://menyamuhinzi:change-me@localhost:5432/menyamuhinzi_test?schema=public
